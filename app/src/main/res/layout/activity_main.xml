<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F111A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Статус подключения -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1B1E2E"
                android:padding="12dp"
                android:text="Ожидание подключения..."
                android:textColor="#FF1744"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="#00E5FF"
                android:text="СВЯЗЬ"
                android:textColor="#0F111A"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Навигация по экранам карусели -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1B1E2E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/btnPrevScreen"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:backgroundTint="#252836"
                android:text="◀"
                android:textColor="#00E5FF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvScreenTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1/5 ГРАФИК ТОКА"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNextScreen"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:backgroundTint="#252836"
                android:text="▶"
                android:textColor="#00E5FF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Контейнер свайпа (карусель экранов) -->
        <FrameLayout
            android:id="@+id/carouselContainer"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="8dp"
            android:background="#1B1E2E"
            android:padding="8dp">

            <!-- Экран 0: График тока (Canvas) -->
            <com.haldex.controller.GraphView
                android:id="@+id/graphView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Экран 1: Скорость по колёсам -->
            <LinearLayout
                android:id="@+id/pageWheels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="#252836"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FL: " android:textColor="#8A8D9F" android:textSize="13sp" />
                        <TextView android:id="@+id/tvFl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 км/ч" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="#252836"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FR: " android:textColor="#8A8D9F" android:textSize="13sp" />
                        <TextView android:id="@+id/tvFr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 км/ч" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="#252836"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RL: " android:textColor="#8A8D9F" android:textSize="13sp" />
                        <TextView android:id="@+id/tvRl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 км/ч" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="1"
                        android:background="#252836"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RR: " android:textColor="#8A8D9F" android:textSize="13sp" />
                        <TextView android:id="@+id/tvRr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 км/ч" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvWheelSlip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#0F111A"
                    android:padding="10dp"
                    android:text="БУКС: 0.0 км/ч"
                    android:textAlignment="center"
                    android:textColor="#00E676"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Экран 2: CAN Телеметрия -->
            <LinearLayout
                android:id="@+id/pageTelemetry"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:id="@+id/tvCanSpeed" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="Скорость: 0 км/ч" android:textColor="#FFFFFF" android:textSize="15sp" />
                <TextView android:id="@+id/tvCanRpm" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="Обороты: 0 RPM" android:textColor="#FFFFFF" android:textSize="15sp" />
                <TextView android:id="@+id/tvCanGas" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="Педаль газа: 0%" android:textColor="#FFFFFF" android:textSize="15sp" />
                <TextView android:id="@+id/tvCanSteer" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="Угол руля: 0.0°" android:textColor="#FFFFFF" android:textSize="15sp" />
                <TextView android:id="@+id/tvCanBrake" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="Педаль тормоза: ОТПУЩЕН" android:textColor="#00E676" android:textSize="15sp" />
                <TextView android:id="@+id/tvCanPwm" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="ШИМ клапана N373: 0 / 255" android:textColor="#00E5FF" android:textSize="15sp" />
            </LinearLayout>

            <!-- Экран 3: Диагностика -->
            <LinearLayout
                android:id="@+id/pageDiagnostic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:id="@+id/tvDiagHydr" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="Гидравлика: OK" android:textColor="#00E676" android:textSize="14sp" />
                <TextView android:id="@+id/tvDiagCan" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="CAN-шина: ONLINE" android:textColor="#00E676" android:textSize="14sp" />
                <TextView android:id="@+id/tvDiagOil" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="Температура масла: 0 °C (R: 0)" android:textColor="#FFFFFF" android:textSize="14sp" />
                <TextView android:id="@+id/tvDiagPump" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="Насос V181: ВЫКЛ" android:textColor="#8A8D9F" android:textSize="14sp" />
                <TextView android:id="@+id/tvDiagCut" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="Отсечки безопасности: НЕТ" android:textColor="#FFFFFF" android:textSize="14sp" />
                <TextView android:id="@+id/tvDiagCurrent" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:text="Ток соленоида: 0.00 А (Цель: 0.00 А)" android:textColor="#00E5FF" android:textSize="14sp" />
            </LinearLayout>

            <!-- Экран 4: Настройка AWD -->
            <LinearLayout
                android:id="@+id/pageAwdSetup"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="БЛОКИРОВКА AWD" android:textColor="#8A8D9F" android:textSize="14sp" />
                <TextView android:id="@+id/tvAwdLockValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textColor="#FFD600" android:textSize="45sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvAwdPressure" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P(est): ~35.0 bar" android:textColor="#FFFFFF" android:textSize="16sp" />
                <TextView android:id="@+id/tvAwdAmps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Ток: 1.35 А" android:textColor="#00E5FF" android:textSize="16sp" />
            </LinearLayout>

        </FrameLayout>

        <!-- Кнопки выбора режимов -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEco"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#2E334D"
                android:text="ECO"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAuto"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#2E334D"
                android:text="AUTO"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAwd"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#2E334D"
                android:text="AWD"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Кнопки регулировки блокировки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMinus"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#1B1E2E"
                android:text="[ - 5% ]"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPlus"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:backgroundTint="#1B1E2E"
                android:text="[ + 5% ]"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Насос -->
        <Button
            android:id="@+id/btnPump"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#1B1E2E"
            android:text="НАСОС: ВЫКЛ"
            android:textColor="#8A8D9F"
            android:textStyle="bold" />

        <!-- Аварийные кнопки -->
        <Button
            android:id="@+id/btnKill"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#FF1744"
            android:text="EMERGENCY KILL"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#1B1E2E"
            android:text="СБРОС АВАРИИ И ОШИБОК"
            android:textColor="#8A8D9F"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
