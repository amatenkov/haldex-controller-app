<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_match"
    android:layout_height="match_parent"
    android:background="#0F111A"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Статус подключения -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#1B1E2E"
            android:padding="12dp"
            android:text="Ожидание подключения..."
            android:textColor="#FF1744"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnConnect"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#00E5FF"
            android:text="СВЯЗЬ"
            android:textColor="#0F111A"
            app:layout_constraintBottom_toBottomOf="@+id/tvStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvStatus" />

        <!-- Высокопроизводительный график Canvas -->
        <com.haldex.controller.GraphView
            android:id="@+id/graphView"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/tvStatus" />

        <!-- Блок телеметрии -->
        <GridLayout
            android:id="@+id/gridLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2"
            android:rowCount="2"
            app:layout_constraintTop_toBottomOf="@+id/graphView">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="#1B1E2E"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="СКОРОСТЬ" android:textColor="#8A8D9F" android:textSize="11sp" />
                <TextView android:id="@+id/tvSpeed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 км/ч" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="#1B1E2E"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ТЕМП. МАСЛА" android:textColor="#8A8D9F" android:textSize="11sp" />
                <TextView android:id="@+id/tvTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 °C" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="#1B1E2E"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="БУКС / РАЗНИЦА" android:textColor="#8A8D9F" android:textSize="11sp" />
                <TextView android:id="@+id/tvSlip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 км/ч" android:textColor="#00E676" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="#1B1E2E"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="БЛОКИРОВКА" android:textColor="#8A8D9F" android:textSize="11sp" />
                <TextView android:id="@+id/tvLock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="#00E5FF" android:textSize="20sp" android:textStyle="bold" />
            </LinearLayout>
        </GridLayout>

        <!-- Системные статусы -->
        <TextView
            android:id="@+id/tvExtraInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Тормоз: - | Насос: -"
            android:textAlignment="center"
            android:textColor="#8A8D9F"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@+id/gridLayout" />

        <!-- Кнопки выбора режимов -->
        <LinearLayout
            android:id="@+id/modeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/tvExtraInfo">

            <Button
                android:id="@+id/btnEco"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#2E334D"
                android:text="ECO"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAuto"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#2E334D"
                android:text="AUTO"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAwd"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#2E334D"
                android:text="AWD"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Кнопки регулировки блокировки -->
        <LinearLayout
            android:id="@+id/adjustLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/modeLayout">

            <Button
                android:id="@+id/btnMinus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#1B1E2E"
                android:text="[ - 5% ]"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnPlus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:backgroundTint="#1B1E2E"
                android:text="[ + 5% ]"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Второстепенные органы управления -->
        <Button
            android:id="@+id/btnPump"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1B1E2E"
            android:text="УПРАВЛЕНИЕ НАСОСОМ"
            android:textColor="#00E676"
            app:layout_constraintTop_toBottomOf="@+id/adjustLayout" />

        <!-- Кнопка аварийного выключения -->
        <Button
            android:id="@+id/btnKill"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FF1744"
            android:text="EMERGENCY KILL"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@+id/btnPump" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1B1E2E"
            android:text="СБРОС ОШИБОК / СБРОС АВАРИИ"
            android:textColor="#8A8D9F"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@+id/btnKill" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
